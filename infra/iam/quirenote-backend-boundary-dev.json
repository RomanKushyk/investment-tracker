{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:eu-north-1:*:log-group:/aws/lambda/quirenote-backend-*",
        "arn:aws:logs:eu-north-1:*:log-group:/aws/lambda/quirenote-backend-*:log-stream:*"
      ]
    },
    {
      "Sid": "WriteTraces",
      "Effect": "Allow",
      "Action": [
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords",
        "xray:GetSamplingRules",
        "xray:GetSamplingTargets",
        "xray:GetSamplingStatisticSummaries"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectToDsql",
      "Effect": "Allow",
      "Action": ["dsql:DbConnectAdmin", "dsql:DbConnect"],
      "Resource": "arn:aws:dsql:eu-north-1:*:cluster/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/env": ["dev", "archive"]
        }
      }
    },
    {
      "Sid": "AssumeTheArchiveReader",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/quirenote-backend-archive-reader"
    },
    {
      "Sid": "ReadBackupFreshness",
      "Effect": "Allow",
      "Action": "backup:ListRecoveryPointsByBackupVault",
      "Resource": "arn:aws:backup:eu-north-1:*:backup-vault:quirenote-backups"
    },
    {
      "Sid": "ReadTheBotCheckSecret",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-north-1:*:parameter/quirenote/dev/turnstile-secret"
    },
    {
      "Sid": "ReadTheBotCheckBypass",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-north-1:*:parameter/quirenote/dev/bot-check-bypass"
    },
    {
      "Sid": "DecryptTheBotCheckSecret",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:eu-north-1:*:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.eu-north-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadAlertChannel",
      "Effect": "Allow",
      "Action": ["notifications:ListNotificationConfigurations", "notifications:ListChannels"],
      "Resource": "*"
    },
    {
      "Sid": "UserPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminGetUser",
        "cognito-idp:AdminDisableUser",
        "cognito-idp:AdminEnableUser",
        "cognito-idp:ListUsers",
        "cognito-idp:AdminLinkProviderForUser",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:AdminUserGlobalSignOut"
      ],
      "Resource": "arn:aws:cognito-idp:eu-north-1:*:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/env": "dev"
        }
      }
    },
    {
      "Sid": "InvokeScheduledFunctions",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:eu-north-1:*:function:quirenote-backend-*"
    },
    {
      "Sid": "InvokeArchiveCapture",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:eu-north-1:*:function:quirenote-backend-CaptureFunction-*"
    },
    {
      "Sid": "DeadLetter",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:eu-north-1:*:quirenote-backend-*"
    },
    {
      "Sid": "NotProductionsNames",
      "Effect": "Deny",
      "Action": ["lambda:*", "logs:*", "sqs:*"],
      "Resource": [
        "arn:aws:lambda:eu-north-1:*:function:quirenote-backend-user-p*",
        "arn:aws:logs:eu-north-1:*:log-group:/aws/lambda/quirenote-backend-user-p*",
        "arn:aws:logs:eu-north-1:*:log-group:/aws/lambda/quirenote-backend-user-p*:log-stream:*",
        "arn:aws:sqs:eu-north-1:*:quirenote-backend-user-p*"
      ]
    }
  ]
}
