                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "USERNAME",
                      "PREFERRED_CHALLENGE",
                      "SRP_A"
                    ],
                    "properties": {
                      "USERNAME": {
                        "type": "string",
                        "minLength": 1
                      },
                      "PREFERRED_CHALLENGE": {
                        "type": "string",
                        "enum": [
                          "PASSWORD_SRP"
                        ]
                      },
                      "SRP_A": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          }
