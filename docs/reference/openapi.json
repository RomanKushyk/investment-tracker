              }
            },
            "content": {
              "application/json": {
                "examples": {
                  "challenge": {
                    "value": {
                      "challenge": "PASSWORD_VERIFIER",
                      "session": "<session>",
                      "parameters": {
                        "USER_ID_FOR_SRP": "<username>",
                        "SRP_B": "<hex>",
                        "SALT": "<hex>",
